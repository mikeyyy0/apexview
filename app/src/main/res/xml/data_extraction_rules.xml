<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: settings and layouts go along to backups and a new phone; the F1 TV
     sign-in (its token, and the sign-in page's cookies) stays on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth.xml" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth.xml" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
